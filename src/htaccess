# Нейрорейтинг: настройки для Apache (на nginx этот файл игнорируется)
AddDefaultCharset utf-8
AddType font/woff2 .woff2
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Старые адреса: страница рейтинга переехала с b.html на главную.
# 301-редирект сохраняет параметры (?dir=marketing&utm_source=...), поэтому рекламные ссылки продолжают работать.
# /about/ и /top-10/ отдаются файлами about.html и top-10.html из корня — работает и без папок about/ и top-10/.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^b\.html$ / [R=301,L]
  RewriteRule ^about$ /about/ [R=301,L]
  RewriteRule ^top-10$ /top-10/ [R=301,L]
  RewriteRule ^about/(index\.html)?$ /about.html [L]
  RewriteRule ^top-10/(index\.html)?$ /top-10.html [L]
</IfModule>

# Ненайденный адрес — честная страница 404 (не главная), чтобы пропавший файл сразу был заметен
ErrorDocument 404 /404.html
