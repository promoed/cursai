# Нейрорейтинг: настройки для Apache (на nginx этот файл игнорируется)
AddDefaultCharset utf-8
AddType font/woff2 .woff2
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Старые адреса: страница рейтинга переехала с b.html на главную, «О нас» — на /about/.
# 301-редирект сохраняет параметры (?dir=marketing&utm_source=...), поэтому рекламные ссылки продолжают работать.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^b\.html$ / [R=301,L]
  RewriteRule ^about\.html$ /about/ [R=301,L]
</IfModule>

ErrorDocument 404 /index.html
