# Нейрорейтинг: настройки для Apache (на nginx этот файл игнорируется)
AddDefaultCharset utf-8
AddType font/woff2 .woff2
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Старые адреса: страница рейтинга переехала с b.html на главную.
# 301-редирект сохраняет параметры (?dir=marketing&utm_source=...), поэтому рекламные ссылки продолжают работать.
# Страница «Курсы по ИИ» (/top-10/) закрыта: 301 на главную с сохранением параметров (рекламные ссылки не ломаются).
# /about/ отдается файлом about.html из корня — работает и без папки about/.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^b\.html$ / [R=301,L]
  RewriteRule ^about$ /about/ [R=301,L]
  RewriteRule ^top-10(/.*|\.html)?$ / [R=301,L]
  RewriteRule ^about/(index\.html)?$ /about.html [L]
  # Страницы направлений рейтинга (cursai.ru/ii-agenty/ и т. п.): без слеша — на адрес со слешем,
  # сам адрес отдается плоским файлом slug.html из корня — работает и без загруженных папок
  # Блог: /blog/ и /blog/slug/ отдаются плоскими файлами blog.html и blog-slug.html (работает и без папок)
  RewriteRule ^blog$ /blog/ [R=301,L]
  RewriteRule ^blog/([a-z0-9-]+)$ /blog/$1/ [R=301,L]
  RewriteRule ^blog/(index\.html)?$ /blog.html [L]
  RewriteRule ^blog/([a-z0-9-]+)/(index\.html)?$ /blog-$1.html [L]
  RewriteRule ^(kursy\-ii|ii\-dlya\-sebya|ii\-dlya\-raboty|ii\-dlya\-marketinga|ii\-agenty|novaya\-professiya|data\-science|graficheskij\-dizajn)$ /$1/ [R=301,L]
  RewriteRule ^(kursy\-ii|ii\-dlya\-sebya|ii\-dlya\-raboty|ii\-dlya\-marketinga|ii\-agenty|novaya\-professiya|data\-science|graficheskij\-dizajn)/(index\.html)?$ /$1.html [L]
</IfModule>

# Ненайденный адрес — честная страница 404 (не главная), чтобы пропавший файл сразу был заметен
ErrorDocument 404 /404.html
